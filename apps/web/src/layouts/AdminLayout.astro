---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Panel Admin - TokoHijau' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[var(--color-surface)] text-[var(--color-ink)] antialiased">
    <div class="mx-auto flex min-h-screen max-w-7xl flex-col md:flex-row">
      <aside class="w-full bg-white p-5 md:w-56 md:shrink-0">
        <a href="/admin" class="block text-base font-bold text-[var(--color-brand)]">
          TokoHijau Admin
        </a>
        <nav class="mt-6 flex flex-col gap-2 text-sm font-medium">
          <a href="/admin" class="px-3 py-2 hover:bg-[var(--color-surface)]">Ringkasan</a>
          <a href="/admin/produk" class="px-3 py-2 hover:bg-[var(--color-surface)]">Produk</a>
          <a href="/admin/pesanan" class="px-3 py-2 hover:bg-[var(--color-surface)]">Pesanan</a>
          <a href="/admin/kupon" class="px-3 py-2 hover:bg-[var(--color-surface)]">Kupon</a>
          <a href="/admin/webhook" class="px-3 py-2 hover:bg-[var(--color-surface)]">Payhook</a>
          <a href="/admin/pengaturan" class="px-3 py-2 hover:bg-[var(--color-surface)]">Pengaturan</a>
        </nav>
      </aside>
      <main class="flex-1 p-6">
        <slot />
      </main>
    </div>
  </body>
</html>
